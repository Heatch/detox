{
  "name": "detox",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @detox/dashboard --filter @detox/pipeline dev",
    "pipeline": "pnpm --filter @detox/pipeline run-pipeline",
    "eval": "pnpm --filter @detox/pipeline eval",
    "weather:score": "pnpm --filter @detox/pipeline weather:score",
    "start": "pnpm --filter @detox/dashboard start",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test"
  }
}
