# Secrets — copy to .env and fill in. Never commit .env.
# config/ and evals/ are likewise untracked: portfolio, taste profile, and
# thresholds live on disk only, so back them up.
NEWSFLASH_API_KEY=
BACKBOARD_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
# Spotify: client ID only (PKCE, no secret needed). Register this exact
# redirect URI in the Spotify Developer Dashboard, allowlist your account
# under User Management (Development Mode), then run:
#   python scripts/spotify_auth.py
# Tokens land in data/spotify_tokens.json (refreshed automatically).
SPOTIFY_CLIENT_ID=
# Optional override if port 43210 is taken (must match the dashboard registration):
# SPOTIFY_REDIRECT_PORT=
TICKETMASTER_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TMDB_API_KEY=
# ITAD API key (NOT the OAuth id/secret pair — those are for user-scope
# endpoints we don't use). From isthereanydeal.com/apps "My Apps" page.
ITAD_KEY=
