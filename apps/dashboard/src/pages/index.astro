---
import Lane from "../components/Lane.astro";
import Item from "../components/Item.astro";
import "../styles/tokens.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import { readSnapshot } from "./api/state.js";

interface Comment {
  author?: string;
  score?: number | null;
  body?: string;
}

interface LaneItem {
  id: string;
  title: string;
  summary?: string | null;
  content?: string;
  comments?: Comment[];
  meta?: { outlet?: string; age?: string; score?: number; comments?: number };
  url?: string;
}

interface WeatherLocation {
  id: string;
  name: string;
  context?: string;
  parts?: { name: string; consensus: number | null; sources: Record<string, number | null> }[];
  spread?: string;
  week?: {
    day: string;
    date: string;
    consensus: [number | null, number | null];
    sources: Record<string, [number | null, number | null]>;
    spread?: string;
  }[];
}

interface LaneBlock {
  title?: string;
  items?: LaneItem[];
  context?: string;
  defaultLocation?: string;
  locations?: WeatherLocation[];
  // v1 stub shape (kept working until replaced)
  parts?: { name: string; consensus: number | null; sources: (number | null)[] }[];
}

const { snapshot } = readSnapshot();
const snap = (snapshot ?? {}) as {
  generatedAt?: string;
  runId?: number;
  laneCounts?: Record<string, { shown: number; collected: number }>;
  digest?: { text: string; generatedBy: string };
  laneStatus?: Record<string, { ok: boolean; note: string | null }>;
  lanes?: Record<string, LaneBlock>;
  discarded?: Record<string, { id: string; title: string; reason: string; ruleScore?: number | null }[]>;
  cost?: {
    usdToday: number;
    capUsd: number;
    degraded: boolean;
    providers?: Record<string, { requestsToday: number; requestsCap: number; spentUsd: number }>;
  };
};

const counts = snap.laneCounts ?? {};
const shownTotal = Object.values(counts).reduce((a, c) => a + (c.shown ?? 0), 0);
const collectedTotal = Object.values(counts).reduce((a, c) => a + (c.collected ?? 0), 0);
const cost = snap.cost ?? { usdToday: 0, capUsd: 0.05, degraded: false };
const geminiUsage = snap.cost?.providers?.["google-ai-studio"];
const usageLine =
  `LLM cost today $${cost.usdToday.toFixed(3)} of $${cost.capUsd.toFixed(2)} (Luna)` +
  (geminiUsage ? `, Gemini ${geminiUsage.requestsToday} of ${geminiUsage.requestsCap} requests` : "") +
  ".";
const discarded = snap.discarded ?? {};
const discardedLanes = Object.entries(discarded).filter(([, cuts]) => cuts.length > 0);
const lanes = snap.lanes ?? {};
const laneStatus = snap.laneStatus ?? {};
const weather = (lanes["weather"] ?? {}) as LaneBlock;

const dateStr = snap.generatedAt
  ? new Date(snap.generatedAt).toLocaleDateString("en-CA", { weekday: "long", month: "long", day: "numeric", timeZone: "America/Toronto" })
  : "No snapshot yet";

function laneItems(id: string): (LaneItem & { metaText: string })[] {
  return ((lanes[id] as LaneBlock | undefined)?.items ?? []).map((it) => ({
    ...it,
    metaText: [it.meta?.outlet, it.meta?.age].filter(Boolean).join(", "),
  }));
}
function laneTitle(id: string, fallback: string) {
  return ((lanes[id] as LaneBlock | undefined)?.title ?? fallback);
}
function laneContext(id: string) {
  const c = counts[id];
  return c ? `Selected ${c.shown} of ${c.collected} items.` : undefined;
}
function laneNote(id: string) {
  const s = laneStatus[id];
  return s && !s.ok ? s.note ?? "Source did not respond." : undefined;
}

// Layout (§9.9): masthead → digest → weather → two news columns + rail.
// Phase 3A: science/math/infrastructure/canada-gta join tech as live lanes;
// holdings/sports stay stubbed until 3C/3B.
const newsLeft = ["tech", "science", "math"];
const newsRight = ["infrastructure", "canada-gta", "holdings", "sports"];
const rail = ["releases", "reddit-nba", "reddit-uwaterloo"];
const railReddit = ["reddit-nba", "reddit-torontoraptors", "reddit-uwaterloo"];
const railRest = ["releases"];
const SOURCE_NAMES: Record<string, string> = { envcan: "Environment Canada", openmeteo: "Open-Meteo", metno: "MET Norway" };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Detox</title>
</head>
<body>
<div class="page">
  <header class="masthead">
    <div class="wordmark">Detox<span class="dot">.</span></div>
    <div class="masthead-right">
      <div class="meta num">{dateStr}</div>
      <div class="meta num" id="status-line">Updated {snap.generatedAt ? new Date(snap.generatedAt).toLocaleTimeString("en-CA", { hour: "numeric", minute: "2-digit", timeZone: "America/Toronto" }) : "never"}.</div>
    </div>
  </header>

  <section class="digest">
    <p class="morning">{snap.digest?.text ?? "No digest yet — run the pipeline."}</p>
    <div class="digest-controls">
      <div class="meta num">Selected {shownTotal} of {collectedTotal} items. {usageLine}</div>
      <button class="btn btn-primary" id="refresh-btn" type="button">Refresh</button>
    </div>
  </section>

  <section class="lane" aria-label="Weather">
    <h2 class="lane-title">Weather</h2>
    {(weather.locations ?? []).length > 0 ? (
      <>
        <div class="pills" role="group" aria-label="Location">
          {weather.locations!.map((loc, i) => (
            <button class={`pill${i === 0 ? " pill-on" : ""}`} type="button" data-loc={loc.id}>{loc.name}</button>
          ))}
        </div>
        {weather.locations!.map((loc, i) => (
          <div class="loc" data-loc={loc.id} hidden={i !== 0}>
            {loc.context && <p class="lane-context meta">{loc.context}</p>}
            {laneNote("weather") && <p class="lane-context meta">{laneNote("weather")}</p>}
            <table>
              <thead><tr><th></th><th>Consensus</th><th>Environment Canada</th><th>Open-Meteo</th><th>MET Norway</th></tr></thead>
              <tbody>
                {(loc.parts ?? []).map((p) => (
                  <tr>
                    <td>{p.name}</td>
                    <td class="cons num">{p.consensus ?? "—"}°</td>
                    <td class="num">{p.sources["envcan"] ?? "—"}°</td>
                    <td class="num">{p.sources["openmeteo"] ?? "—"}°</td>
                    <td class="num">{p.sources["metno"] ?? "—"}°</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {(loc.week ?? []).length > 0 && (
              <table>
                <thead><tr><th></th><th>Consensus</th><th>Environment Canada</th><th>Open-Meteo</th><th>MET Norway</th></tr></thead>
                <tbody>
                  {(loc.week ?? []).map((w) => (
                    <tr>
                      <td>{w.day}<br /><span class="meta num">{w.date}</span></td>
                      <td class="cons num">{w.consensus[0] ?? "—"}° <span class="meta">{w.consensus[1] ?? "—"}°</span>{w.spread && <><br /><span class="meta">{w.spread}</span></>}</td>
                      <td class="num">{w.sources["envcan"]?.[0] ?? "—"}° <span class="meta">{w.sources["envcan"]?.[1] ?? "—"}°</span></td>
                      <td class="num">{w.sources["openmeteo"]?.[0] ?? "—"}° <span class="meta">{w.sources["openmeteo"]?.[1] ?? "—"}°</span></td>
                      <td class="num">{w.sources["metno"]?.[0] ?? "—"}° <span class="meta">{w.sources["metno"]?.[1] ?? "—"}°</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {loc.spread && <p class="meta">{loc.spread}</p>}
          </div>
        ))}
        <script>
          document.querySelectorAll(".pill[data-loc]").forEach((pill) => {
            pill.addEventListener("click", () => {
              const want = pill.getAttribute("data-loc");
              document.querySelectorAll(".pill[data-loc]").forEach((p) =>
                p.classList.toggle("pill-on", p === pill));
              document.querySelectorAll(".loc[data-loc]").forEach((l) => {
                l.toggleAttribute("hidden", l.getAttribute("data-loc") !== want);
              });
            });
          });
        </script>
      </>
    ) : (
      <>
        <p class="lane-context meta">{weather.context ?? ""}</p>
        <table>
          <thead><tr><th></th><th>Consensus</th><th>Environment Canada</th><th>Open-Meteo</th><th>MET Norway</th></tr></thead>
          <tbody>
            {(weather.parts ?? []).map((p) => (
              <tr>
                <td>{p.name}</td>
                <td class="cons num">{p.consensus ?? "—"}°</td>
                {(p.sources ?? []).map((s) => (<td class="num">{s ?? "—"}°</td>))}
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
  </section>

  <div class="columns">
    <div class="col">
      {newsLeft.map((id) => (
        <Lane title={laneTitle(id, id)} context={laneContext(id)}>
          {laneNote(id) && <p class="meta">{laneNote(id)}</p>}
          {laneItems(id).map((it) => (<Item title={it.title} summary={it.summary ?? undefined} meta={it.metaText} url={it.url} />))}
        </Lane>
      ))}
    </div>
    <div class="col">
      {newsRight.map((id) => (
        <Lane title={laneTitle(id, id)} context={laneContext(id)}>
          {laneNote(id) && <p class="meta">{laneNote(id)}</p>}
          {laneItems(id).map((it) => (<Item title={it.title} summary={it.summary ?? undefined} meta={it.metaText} url={it.url} />))}
        </Lane>
      ))}
    </div>
    <div class="rail">
      {railRest.map((id) => (
        <Lane title={laneTitle(id, id)} context={laneContext(id)}>
          {laneItems(id).map((it) => (<Item title={it.title} summary={it.summary ?? undefined} meta={it.metaText} url={it.url} />))}
        </Lane>
      ))}
      {railReddit.filter((id) => (lanes[id] as LaneBlock | undefined)?.items?.length || laneNote(id)).map((id) => (
        <Lane title={laneTitle(id, id)} context={laneContext(id)}>
          {laneNote(id) && <p class="meta">{laneNote(id)}</p>}
          {laneItems(id).map((it) => (
            <article>
              <h3 class="item-title">{it.url ? <a href={it.url}>{it.title}</a> : it.title}</h3>
              <p class="item-meta meta">{[
                it.meta?.outlet,
                it.meta?.comments != null ? `${it.meta.comments} comments` : null,
                it.meta?.score != null ? `${it.meta.score} points` : null,
                it.meta?.age,
              ].filter(Boolean).join(", ")}</p>
              {it.content && <p class="item-summary">{it.content.length > 600 ? it.content.slice(0, 600) + "…" : it.content}</p>}
              {(it.comments ?? []).map((c) => (
                <p class="small" style="padding-top: 8px; padding-left: 12px; border-left: 1px solid var(--line);">
                  {c.body}{c.score != null && <span class="meta"> — {c.author}, {c.score} points</span>}
                </p>
              ))}
            </article>
          ))}
        </Lane>
      ))}
    </div>
  </div>

  <footer class="footer">
    <p class="meta num">Selected {shownTotal} of {collectedTotal} items. {usageLine}{cost.degraded ? " Over budget — running rules-only." : ""}</p>
    {discardedLanes.length > 0 && (
      <details>
        <summary class="meta">Discarded today</summary>
        {discardedLanes.map(([lane, cuts]) => (
          <div>
            <p class="meta">{laneTitle(lane, lane)} — {cuts.length} cut</p>
            {cuts.map((c) => (
              <p class="meta">{c.title} — {c.reason}{c.ruleScore != null ? ` (relevance ${c.ruleScore})` : ""}</p>
            ))}
          </div>
        ))}
      </details>
    )}
    <p class="meta">Live data. Reddit posts and comments shown in full, unedited.</p>
  </footer>
</div>

<script>
  // Stale-on-open (§4, rule 1) + manual refresh (§4, rule 3). Renders the cached
  // snapshot instantly; a background refresh never blanks the page.
  (async () => {
    const status = document.getElementById("status-line");
    const btn = document.getElementById("refresh-btn");
    const say = (t) => { if (status) status.textContent = t; };
    const poll = async () => (await (await fetch("/api/state")).json());
    let first;
    try { first = await poll(); } catch { say("Dashboard unreachable."); return; }
    const snapId = first?.snapshot?.runId ?? null;
    const fmt = (iso) => new Date(iso).toLocaleTimeString("en-CA", { hour: "numeric", minute: "2-digit", timeZone: "America/Toronto" });
    if (first.lastSuccessfulRun) say(`Updated ${fmt(first.lastSuccessfulRun)}.`);
    async function refresh() {
      say("Refreshing. Showing the last snapshot meanwhile.");
      try { await fetch("/api/refresh", { method: "POST" }); } catch { say("Refresh failed to start."); return; }
      for (let i = 0; i < 30; i++) {
        await new Promise((r) => setTimeout(r, 4000));
        try {
          const s = await poll();
          if (!s.refreshing && (s?.snapshot?.runId ?? null) !== snapId) { location.reload(); return; }
        } catch { /* keep polling */ }
      }
      say("Still refreshing — check back shortly.");
    }
    if (btn) btn.addEventListener("click", refresh);
    if (first.stale) void refresh();
  })();
</script>
</body>
</html>
